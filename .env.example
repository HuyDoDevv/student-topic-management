# Copy to .env and load in zsh/bash with: set -a; source ./.env; set +a
# Spring Boot and Maven Wrapper do not automatically load this file.
# JDK 21 installed on this Mac; adjust for another machine.
JAVA_HOME='/opt/homebrew/opt/openjdk@21'

# local = MySQL enabled; preview = UI only, no database.
SPRING_PROFILES_ACTIVE='local'
SERVER_PORT=8080

# Use an existing MySQL 8.4 database and account. Store instants in UTC.
SPRING_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3306/topic_registration_local?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true'
SPRING_DATASOURCE_USERNAME='topic_local'
SPRING_DATASOURCE_PASSWORD='REPLACE_WITH_YOUR_DATABASE_PASSWORD'

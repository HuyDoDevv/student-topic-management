# Copy this file to .env. run.sh and run.cmd load it automatically.
# Configure JAVA_HOME in the operating system, or uncomment one matching example:
# JAVA_HOME=/opt/homebrew/opt/openjdk@21
# JAVA_HOME=C:/Program Files/Java/jdk-21

# local = MySQL enabled; preview = UI only, no database.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Use an existing MySQL 8.4 database and account. Store instants in UTC.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/topic_registration_local?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=topic_local
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD

# Optional local demo data. Set true once, choose a password, start the app, then set false.
# The password is hashed before storage and is shared only by the generated *.demo accounts.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=REPLACE_ONLY_WHEN_DEMO_SEED_IS_ENABLED
# Optional: choose a persistent folder for uploaded/demo PDF reports.
# REPORT_STORAGE_ROOT=/absolute/path/to/topic-registration-reports

# Used only by ./mvnw verify -Pintegration and -Pe2e. The database name must contain "test".
TEST_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/topic_registration_test?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
TEST_DATABASE_USERNAME=topic_test
TEST_DATABASE_PASSWORD=REPLACE_WITH_YOUR_TEST_DATABASE_PASSWORD
E2E_ACCOUNT_PASSWORD=REPLACE_WITH_A_TEMPORARY_E2E_LOGIN_PASSWORD
